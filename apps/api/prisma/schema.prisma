generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  /// Ochiq `@username`: doim kichik harfda (CHECK constraint) — katta-kichik harf farqsiz unique.
  username     String?  @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  photoUrl     String?  @map("photo_url")
  bio          String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Oxirgi marta onlayn bo'lgan vaqt (oxirgi WebSocket ulanishi uzilganda yoziladi)
  lastSeenAt   DateTime? @map("last_seen_at") @db.Timestamptz(3)
  /// Push'da yuboruvchi va matn ko'rinadimi (maxfiylik). `false` — faqat "Yangi xabar".
  notificationPreview Boolean @default(true) @map("notification_preview")

  memberships   ChatMember[]
  messages      Message[]
  attachments   Attachment[]
  refreshTokens RefreshToken[]
  passwordResets PasswordResetToken[]
  devices       DeviceToken[]
  blocking      UserBlock[] @relation("blocker")
  blockedBy     UserBlock[] @relation("blocked")

  @@map("users")
}

/// Refresh token: bazada faqat sha256 hash saqlanadi. Har `refresh` da eski
/// token bekor qilinib, o'sha `familyId` bilan yangisi beriladi (rotatsiya).
/// Bekor qilingan token qayta ishlatilsa — butun oila bekor qilinadi.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Parolni tiklash: bazada faqat sha256 hash. Bir martalik (`usedAt`), 30 daqiqa;
/// yangisi so'ralganda yoki parol o'zgarganda eskilari ham `usedAt` bilan yopiladi.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Ishlatilgan yoki bekor qilingan vaqt.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

enum ChatType {
  direct
  group
  channel

  @@map("chat_type")
}

enum ChatRole {
  owner
  admin
  member

  @@map("chat_role")
}

enum MessageType {
  text
  image
  file
  voice
  system

  @@map("message_type")
}

model Chat {
  id            String    @id @default(uuid()) @db.Uuid
  type          ChatType
  title         String?
  description   String?
  /// Faqat kanal: ochiq kanalni hamma qidirib, obuna bo'la oladi.
  isPublic      Boolean   @default(false) @map("is_public")
  /// Faqat `direct` uchun: ikki user id'si tartiblangan holda "a:b" —
  /// bir juftlik uchun ikkinchi 1:1 chat yaratilmasligini baza kafolatlaydi.
  directKey     String?   @unique @map("direct_key")
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  members     ChatMember[]
  messages    Message[]
  attachments Attachment[]

  @@index([type, isPublic])
  @@map("chats")
}

model ChatMember {
  chatId     String    @map("chat_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  role       ChatRole  @default(member)
  /// Shu vaqtgacha (shu vaqt ham) yuborilgan xabarlar o'qilgan.
  lastReadAt DateTime? @map("last_read_at") @db.Timestamptz(3)
  joinedAt   DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId])
  @@map("chat_members")
}

model Message {
  id        String      @id @default(uuid()) @db.Uuid
  chatId    String      @map("chat_id") @db.Uuid
  senderId  String      @map("sender_id") @db.Uuid
  type      MessageType @default(text)
  content   String
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt  DateTime?   @map("edited_at") @db.Timestamptz(3)
  /// Soft-delete: qator qoladi, tarix/oxirgi xabar/o'qilmagan sonidan chiqariladi.
  deletedAt DateTime?   @map("deleted_at") @db.Timestamptz(3)

  chat       Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender     User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachment Attachment?

  // Tarix: keyset pagination — (created_at, id) bo'yicha kamayish tartibida.
  @@index([chatId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("messages")
}

enum AttachmentKind {
  image
  file
  voice

  @@map("attachment_kind")
}

/// Biriktirma: obyekt S3-mos saqlashda (`key`), bu yerda metadata.
/// `messageId` null — imzolangan yuklash havolasi berilgan, lekin hali xabarga
/// biriktirilmagan (tugatilmagan yuklashlar — cheklov, REJA.md ga qarang).
model Attachment {
  id         String         @id @default(uuid()) @db.Uuid
  uploaderId String         @map("uploader_id") @db.Uuid
  chatId     String         @map("chat_id") @db.Uuid
  kind       AttachmentKind
  key        String         @unique
  name       String
  mime       String
  size       Int
  durationMs Int?           @map("duration_ms")
  messageId  String?        @unique @map("message_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  chat     Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  message  Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([uploaderId])
  @@index([chatId])
  @@map("attachments")
}

enum DevicePlatform {
  android
  ios
  web

  @@map("device_platform")
}

/// Push (FCM) registration token. Bitta token — bitta qurilma/ilova nusxasi;
/// boshqa hisob bilan kirilsa token o'sha hisobga o'tadi (upsert).
model DeviceToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  platform  DevicePlatform
  token     String         @unique
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

/// `blocker` `blocked` ni bloklagan: 1:1 da yozisha olmaydi, bir-biriga push bormaydi.
model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}
