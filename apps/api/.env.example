# docker compose (repo ildizida) bilan mos keladi
DATABASE_URL=postgresql://suhbat:suhbat@localhost:5432/suhbat
# Ishlab chiqarishda uzun tasodifiy qiymat: openssl rand -base64 48
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
PORT=4000
# Vergul bilan; desktop ilova uchun `suhbat://app` ham qo'shing.
CORS_ORIGIN=http://localhost:3000
# Refresh token muddati (kun). Access token muddati — JWT_EXPIRES_IN.
REFRESH_TOKEN_TTL_DAYS=30

# Media (rasm, fayl, ovoz). Standart — `local`: fayllar API diskida, mijoz API'ning
# `/media/blob` manziliga imzolangan qisqa muddatli havola bilan yuklaydi/yuklab oladi.
# Papka: MEDIA_DIR → Railway Volume (`$RAILWAY_VOLUME_MOUNT_PATH/media`, Railway o'zi beradi)
# → ./.data/media. Railway'da Volume'siz fayllar har deploy'da yo'qoladi.
# MEDIA_DIR=/data/media
# Imzolangan havolalardagi API manzili (mijoz ko'radigan). Bo'lmasa `https://$RAILWAY_PUBLIC_DOMAIN`,
# u ham bo'lmasa http://localhost:$PORT. Android emulyatorda: http://10.0.2.2:4000
# PUBLIC_API_URL=https://api.suhbat.uz
# Havola imzosi kaliti (bo'lmasa JWT_SECRET'dan hosil qilinadi)
# MEDIA_SIGNING_SECRET=

# Ixtiyoriy: S3-mos saqlash (MinIO, Cloudflare R2). S3_ENDPOINT berilsa local o'rniga S3.
# Lokal MinIO: `npm run db:up`. S3_ENDPOINT — API ulanadigan manzil; S3_PUBLIC_ENDPOINT —
# mijoz ko'radigan manzil (ko'rsatilmasa S3_ENDPOINT).
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=suhbat
# S3_ACCESS_KEY=suhbat
# S3_SECRET_KEY=suhbat-minio-secret
# `false` — saqlash faqat `bucket.host` (virtual-hosted) uslubini qabul qilsa. Standart: true.
# S3_FORCE_PATH_STYLE=true

# Cheklovlar (hammasi ixtiyoriy; ko'rsatilgan qiymatlar standart)
# REST rate limit: IP va endpoint bo'yicha, oyna THROTTLE_TTL_MS ichida.
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=300
# THROTTLE_AUTH_LIMIT=10        # login / register / refresh / forgot-password / reset-password
# WS message:send: foydalanuvchi bo'yicha
# WS_SEND_LIMIT=30
# WS_SEND_WINDOW_MS=10000
# Proksi (Caddy) ortida haqiqiy IP uchun: proksilar soni
# TRUST_PROXY=1
# Tugatilmagan yuklashlarni tozalash (0 — o'chirish)
# MEDIA_ORPHAN_TTL_HOURS=24
# MEDIA_CLEANUP_INTERVAL_MS=3600000

# Push bildirishnomalar (FCM HTTP v1; Android, iOS — APNs FCM orqali, veb).
# Firebase konsoli → Project settings → Service accounts → "Generate new private key".
# Qiymat: JSON'ning o'zi (bir qatorda) YOKI base64 (`base64 -w0 key.json`).
# Bo'sh bo'lsa push o'chiq — API baribir ishlaydi (logda ogohlantirish).
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"suhbat-xxxx","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n", ...}
# Bir vaqtda FCM'ga ketadigan so'rovlar soni (katta kanal uchun)
# FCM_CONCURRENCY=20

# Qo'ng'iroqlar (WebRTC). Media serverdan o'tmaydi; NAT ortidagi qurilmalar uchun TURN kerak.
# STUN: ko'rsatilmasa stun:stun.l.google.com:19302; bo'sh qiymat — STUN yo'q. Vergul bilan bir nechta.
# STUN_URLS=stun:stun.l.google.com:19302
# TURN (ixtiyoriy, QADAMLAR.md 13; o'z coturn'imiz — infra/turn/): manzillar vergul bilan
# Railway TURN xizmati (faqat TCP Proxy): turn:xxx.proxy.rlwy.net:12345?transport=tcp
# TURN_URLS=turn:turn.example.uz:3478?transport=udp,turn:turn.example.uz:3478?transport=tcp,turns:turn.example.uz:5349
# a) Doimiy login/parol (Cloudflare, metered.ca kabi xizmat beradi):
# TURN_USERNAME=
# TURN_CREDENTIAL=
# b) O'z coturn'ingiz (infra/turn: TURN_SECRET aynan shu qiymat) — har foydalanuvchiga
#    vaqtinchalik login/parol yasaladi (a'dan ustun). openssl rand -hex 32
# TURN_SECRET=
# TURN_TTL_SECONDS=43200
# Javob bo'lmasa qo'ng'iroq shuncha ms dan keyin "javobsiz" (standart 45000)
# CALL_RING_TIMEOUT_MS=45000
# call:invite cheklovi (foydalanuvchi bo'yicha)
# CALL_INVITE_LIMIT=10
# CALL_INVITE_WINDOW_MS=60000

# Email (parolni tiklash xati). Hammasi ixtiyoriy: kalit bo'lmasa API ishlaydi, lekin
# `POST /auth/forgot-password` 503 "Email yuborish hozircha sozlanmagan" qaytaradi.
# Kalitlarni faqat muhitga (Railway Variables) yozing — repoga, chatga EMAS. QADAMLAR.md 14.
# a) Resend HTTP API (ustun): https://resend.com → API Keys
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# b) yoki istalgan SMTP (nodemailer URL): smtps://login:parol@smtp.example.uz:465
# SMTP_URL=
# Jo'natuvchi (Resend'da tasdiqlangan domen; sinovda "Suhbat <onboarding@resend.dev>")
# MAIL_FROM=Suhbat <noreply@suhbat.uz>
# Xatdagi havola: ${WEB_URL}/reset-password?token=... (oxirida / siz). Bo'lmasa tiklash o'chiq.
WEB_URL=http://localhost:3000
# Cheklovlar: IP bo'yicha (xotirada) va hisob bo'yicha (bazada; oshsa xat jim yuborilmaydi)
# FORGOT_PASSWORD_IP_LIMIT=5
# FORGOT_PASSWORD_IP_WINDOW_MS=900000
# FORGOT_PASSWORD_ACCOUNT_LIMIT=3
# FORGOT_PASSWORD_ACCOUNT_WINDOW_MS=3600000
