# docker compose (repo ildizida) bilan mos keladi
DATABASE_URL=postgresql://suhbat:suhbat@localhost:5432/suhbat
# Ishlab chiqarishda uzun tasodifiy qiymat: openssl rand -base64 48
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Refresh token muddati (kun). Access token muddati — JWT_EXPIRES_IN.
REFRESH_TOKEN_TTL_DAYS=30

# S3-mos saqlash (media). Lokal — docker compose'dagi MinIO (`npm run db:up`).
# S3_ENDPOINT — API saqlashga ulanadigan manzil; S3_PUBLIC_ENDPOINT — mijoz
# (brauzer/mobil) ko'radigan manzil, imzolangan URL'lar shu bilan yasaladi
# (ko'rsatilmasa S3_ENDPOINT). Ishlab chiqarishda kalitlarni almashtiring.
S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=suhbat
S3_ACCESS_KEY=suhbat
S3_SECRET_KEY=suhbat-minio-secret
