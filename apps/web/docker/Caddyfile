# Statik server: Railway $PORT ni beradi. SPA — noma'lum yo'llar index.html ga.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Vite fayllari nomida hash bor — uzoq kesh. index.html esa har safar tekshiriladi.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html not path /assets/*
	header @html Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	try_files {path} /index.html
	file_server
}
