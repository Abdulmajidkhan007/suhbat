rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Uploads: only authenticated users can read; uploader scoped by chatId
    match /uploads/{chatId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024
                   && (
                     request.resource.contentType.matches('image/.*') ||
                     request.resource.contentType.matches('application/pdf') ||
                     request.resource.contentType.matches('text/.*') ||
                     request.resource.contentType.matches('application/.*document.*') ||
                     request.resource.contentType.matches('application/.*word.*')
                   );
    }

    // Profile photos
    match /avatars/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
