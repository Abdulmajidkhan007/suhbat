# infra/turn/.env (repoga tushmaydi). API'dagi TURN_SECRET bilan AYNAN bir xil bo'lsin.
# Yaratish: openssl rand -hex 32
TURN_SECRET=
TURN_REALM=suhbat
# Server NAT ortida bo'lsa (bulutdagi ba'zi VPS): ochiq_ip/ichki_ip, masalan 203.0.113.10/10.0.0.5
# TURN_EXTERNAL_IP=
# TLS (turns:...:5349) — sertifikat yo'llari (docker-compose.yml da volumes'ni oching):
# TURN_TLS_CERT=/etc/letsencrypt/live/turn.suhbat.uz/fullchain.pem
# TURN_TLS_KEY=/etc/letsencrypt/live/turn.suhbat.uz/privkey.pem
